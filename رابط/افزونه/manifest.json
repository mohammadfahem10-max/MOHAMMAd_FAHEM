{
  "manifest_version": 3,
  "name": "ثبت من — استخراج و گزارش",
  "description": "نمایش و استخراج داده‌های خودِ کاربر از سامانهٔ «ثبت من» در همان نشستِ واردشده. داده روی رایانهٔ کاربر می‌ماند.",
  "version": "0.1.0",
  "permissions": ["downloads"],
  "host_permissions": ["https://my.ssaa.ir/*", "https://*.ssaa.ir/*", "http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://my.ssaa.ir/*", "https://*.ssaa.ir/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["sabt-man.bundle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://my.ssaa.ir/*", "https://*.ssaa.ir/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
